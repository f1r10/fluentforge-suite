# Plain PostgreSQL runtime: no Supabase/Lovable service required.

POSTGRES_DB=fluentforge
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-long-random-database-password

# Minimum 32 characters. Use independent random secrets.
APP_JWT_SECRET=replace-with-at-least-32-random-characters
APP_STORAGE_SECRET=replace-with-another-32-random-characters
SETUP_TOKEN=replace-with-long-random-setup-token
PROCESSING_SHARED_SECRET=replace-with-long-random-processing-secret
SCHEDULED_JOB_SECRET=replace-with-another-long-random-secret

APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3000

# Optional processing limits/model configuration.
PROCESSING_MAX_SOURCE_BYTES=1073741824
WHISPER_MODEL=small
WHISPER_MODEL_PATH=
WHISPER_MODEL_CACHE=/models/whisper
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
WHISPER_LOCAL_FILES_ONLY=false
WHISPER_BEAM_SIZE=5
WHISPER_VAD_FILTER=true

# Optional AI; core application works with disabled.
AI_PROVIDER=disabled
AI_LOCAL_BASE_URL=
AI_LOCAL_MODEL=
AI_LOCAL_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=
