# Development adapter (Supabase / Lovable Cloud)
SUPABASE_PROJECT_ID=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_URL=""

VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# Optional server-only values
SUPABASE_SERVICE_ROLE_KEY=""
SETUP_TOKEN=""

# Future self-hosted PostgreSQL adapter
DATABASE_URL=""



# Heavy document/OCR/transcription processing service
PROCESSING_SERVICE_URL="http://processing-service:8001"
PROCESSING_SHARED_SECRET="change-me-processing-secret"
# Comma-separated hosts the Python worker may download signed source files from.
# Example for hosted Supabase: your-project.supabase.co
PROCESSING_ALLOWED_SOURCE_HOSTS=""

# Local Faster-Whisper settings (processing-service)
# Prefer WHISPER_MODEL_PATH for a fully offline/self-contained deployment.
WHISPER_MODEL="small"
WHISPER_MODEL_PATH=""
WHISPER_MODEL_CACHE="/models/whisper"
WHISPER_DEVICE="auto"
WHISPER_COMPUTE_TYPE="int8"
WHISPER_LOCAL_FILES_ONLY="false"
WHISPER_BEAM_SIZE="5"
WHISPER_VAD_FILTER="true"


# Optional AI-assisted grading.
# Core FluentForge works with AI_PROVIDER=disabled.
# local = any OpenAI-compatible local endpoint (Ollama/llama.cpp/vLLM/etc.).
# gemini = optional external Gemini API adapter.
AI_PROVIDER="disabled"

AI_LOCAL_BASE_URL=""
AI_LOCAL_MODEL=""
AI_LOCAL_API_KEY=""

GEMINI_API_KEY=""
GEMINI_MODEL=""
