# Public browser configuration. These values are embedded at build time.
VITE_SUPABASE_URL=https://supabase.example.com
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-anon-key

# Server-side Supabase configuration.
SUPABASE_URL=https://supabase.example.com
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Direct PostgreSQL connection used only by the migration container.
DATABASE_URL=postgresql://postgres:replace-me@database.example.com:5432/postgres
DATABASE_SSL=require

# First-run teacher setup secret. Generate a long random value.
SETUP_TOKEN=replace-with-long-random-token

# Web binding.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3000

# Processing service.
PROCESSING_SHARED_SECRET=replace-with-long-random-processing-secret
# Independent secret used by the internal scheduled-backup trigger.
SCHEDULED_JOB_SECRET=replace-with-another-long-random-secret
# Hostnames only, comma-separated. Include the hostname used by signed source URLs.
PROCESSING_ALLOWED_SOURCE_HOSTS=supabase.example.com
PROCESSING_MAX_SOURCE_BYTES=1073741824

# Local Faster-Whisper.
WHISPER_MODEL=small
WHISPER_MODEL_PATH=
WHISPER_MODEL_CACHE=/models/whisper
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
WHISPER_LOCAL_FILES_ONLY=false
WHISPER_BEAM_SIZE=5
WHISPER_VAD_FILTER=true

# Optional AI-assisted grading. Core product works with disabled.
AI_PROVIDER=disabled
AI_LOCAL_BASE_URL=
AI_LOCAL_MODEL=
AI_LOCAL_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=
